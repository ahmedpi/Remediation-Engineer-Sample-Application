          "ruleId": "CWE-208",
          "level": "warning",
          "message": {
            "text": "Non-constant-time comparison of FauxPay API key  [CVSS 6.5: CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:H/A:N]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Node JS/fauxpay/src/server.js"
                },
