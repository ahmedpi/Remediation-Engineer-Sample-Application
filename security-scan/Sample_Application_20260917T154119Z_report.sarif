          "message": {
            "text": "Public review endpoint discloses reviewer user_id and full_name  [CVSS 5.3: CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N]"
          },
          "locations": [
