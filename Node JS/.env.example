# Template for the local training stack — copy to .env and adjust as needed.
# Every value here is a placeholder for local development against disposable
# containers. None of them survive into production, where each secret below is
# held in a secrets manager and injected at runtime. Anything committed in this
# file is public by definition, so it must never carry a real credential.

# Database
DB_NAME=widgetshop
DB_USER=widgetshop
DB_PORT=5432

# Postgres password for the application's database user. TESTING VALUE ONLY —
# this placeholder exists so the training stack boots without setup, and it does
# not survive into production. The account it protects owns every table in the
# schema, so it reads and writes users, password hashes, orders, payments, and
# refunds directly, with none of the application's authorization in the way.
# Note that both api/src/db/knexfile.js and docker-compose.yml also fall back to
# a working default ('widgetshop') when this is unset, which is a training
# convenience and not a production pattern.
#
# In production the value is a long random secret held in a secrets manager
# (Vault / AWS Secrets Manager) or issued dynamically per instance, injected at
# runtime, unique per environment, rotated on a schedule, and paired with a
# least-privilege role rather than the schema owner — never read from a
# checked-in file and never given a code-level default.
DB_PASSWORD=change-me

# API
PORT=3000

# Signing key for session JWTs. TESTING VALUE ONLY — this placeholder exists so
# the training stack boots without setup, and it does not survive into
# production. Anyone holding this string can mint a token for any user id and any
# role, including customer_service and admin, so treat it as public the moment it
# is checked in. In production the value is a long random secret held in a
# secrets manager (Vault / AWS Secrets Manager), injected at runtime into the api
# service only, unique per environment, and rotated on a schedule — never read
# from a checked-in file and never given a code-level default.
JWT_SECRET=change-me-to-a-long-random-string

# FauxPay (fictional payment processor — training environment only).
# These values are placeholders for local development. In production every secret
# here is supplied at runtime from a secrets manager, is unique per environment,
# and is never read from a checked-in file or a code-level default. FauxPay
# itself has no production equivalent: the deployed API calls the real
# processor's hosted endpoints over egress-only TLS.
FAUXPAY_API_KEY=<set-me-per-environment>
